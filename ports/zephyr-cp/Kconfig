# CircuitPython Zephyr port — application Kconfig
#
# Sources Zephyr's main Kconfig, then adds CircuitPython-specific defaults.
# Boards can override any of these in their boards/<board>.conf file.

osource "$(ZEPHYR_BASE)/Kconfig.zephyr"

# ===== Peripheral defaults — enabled by default, boards can disable =====

config I2C
	default y

config SPI
	default y

config SPI_ASYNC
	default y

config I2S
	default y

config UART_LINE_CTRL
	default y

config ENTROPY_GENERATOR
	default y

# ===== Bluetooth defaults =====

# Use a variable for the chosen name so the comma isn't parsed as an argument separator
DT_BT_HCI_CHOSEN := zephyr,bt-hci

config BT
	default $(dt_chosen_enabled,$(DT_BT_HCI_CHOSEN))

config BT_PERIPHERAL
	default y

config BT_CENTRAL
	default y

config BT_BROADCASTER
	default y

config BT_OBSERVER
	default y

config BT_EXT_ADV
	default y

config BT_DEVICE_APPEARANCE_DYNAMIC
	default y

config BT_DEVICE_NAME_DYNAMIC
	default y

config BT_DEVICE_NAME_MAX
	default 28

config BT_L2CAP_TX_MTU
	default 253

# BT Buffers
config BT_BUF_CMD_TX_SIZE
	default 255

config BT_BUF_EVT_RX_COUNT
	default 16

config BT_BUF_EVT_RX_SIZE
	default 255

config BT_BUF_ACL_TX_COUNT
	default 3

config BT_BUF_ACL_TX_SIZE
	default 251

config BT_BUF_ACL_RX_COUNT_EXTRA
	default 1

config BT_BUF_ACL_RX_SIZE
	default 255

config BT_GATT_DYNAMIC_DB
	default y

config BT_GATT_CLIENT
	default y

# Zephyr defaults this to 0, which disables GATT long/reliable writes: any
# Characteristic write that doesn't fit in a single ATT_WRITE_REQ is rejected
# by the host before it reaches common-hal. One prepare buffer is the minimum
# that makes long writes work at all.
config BT_ATT_PREPARE_COUNT
	default 2

# Link supervision timeout. Zephyr's peripheral preferred-parameter default is
# TIMEOUT=42, in 10ms units, so 420ms. With BT_GAP_AUTO_UPDATE_CONN_PARAMS=y
# (also a Zephyr default) the host sends that preference to the central 5s
# into every connection, actively downgrading a link the central had set up
# more conservatively. At 420ms with a 30ms interval, 14 consecutive missed
# connection events drop the link -- thin on any part where the BLE radio
# coexists with Wi-Fi. 400 = 4.0s, Apple's accessory design guideline value.
# Boards with a dedicated radio can override this downward.
config BT_PERIPHERAL_PREF_TIMEOUT
	default 400
